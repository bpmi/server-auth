<odoo>
    <template id="signup_fields" inherit_id="auth_signup.signup">
        <!-- Uninvited (token-less) users sign up passwordless: only show the
             password fields when a valid signup token is present. -->
        <xpath expr="//t[@t-call='auth_signup.fields']" position="attributes">
            <attribute name="t-if">token and not invalid_token</attribute>
        </xpath>
        <!-- Force HTML5 email validation on the login field. -->
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="type">email</attribute>
        </xpath>
    </template>
</odoo>
